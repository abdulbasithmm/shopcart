  "maskableIconUrl": "https://shopcart-olive.vercel.app/pwa-maskable-512x512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "shopcart"
  },
  "appVersionCode": 1,
