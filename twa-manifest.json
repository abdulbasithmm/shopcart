    {
      "name": "Shop Catalog",
      "shortName": "Shop",
      "url": "/shop",
      "chosenIconUrl": "https://shopcart-olive.vercel.app/pwa-192x192.png"
    },
    {
      "name": "My Orders",
      "shortName": "Orders",
      "url": "/account",
      "chosenIconUrl": "https://shopcart-olive.vercel.app/pwa-192x192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://shopcart-olive.vercel.app/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": false
    },
    "playBilling": {
      "enabled": false
    }
  },
  "alphaDependencies": {
    "enabled": false
