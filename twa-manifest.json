{
  "packageId": "com.shopcart.app",
  "host": "shopcart-olive.vercel.app",
  "name": "ShopCart — Online Shopping Marketplace",
  "launcherName": "ShopCart",
  "themeColor": "#0b5c37",
  "themeColorDark": "#042c18",
  "navigationColor": "#0b5c37",
  "navigationColorDark": "#042c18",
  "navigationDividerColor": "#00000000",
  "navigationDividerColorDark": "#00000000",
  "backgroundColor": "#ffffff",
  "enableNotifications": true,
  "startUrl": "/",
