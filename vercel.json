{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin-login",
      "destination": "/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/admin/orders",
      "destination": "/index.html"
    },
    {
      "source": "/admin/products",
      "destination": "/index.html"
    },
    {
      "source": "/admin/categories",
      "destination": "/index.html"
    },
    {
      "source": "/admin/customers",
      "destination": "/index.html"
    },
    {
      "source": "/admin/inventory",
      "destination": "/index.html"
    },
    {
      "source": "/admin/payments",
      "destination": "/index.html"
    },
    {
      "source": "/admin/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/admin/profile",
      "destination": "/index.html"
    },
    {
      "source": "/admin/settings",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/access-denied",
      "destination": "/index.html"
    },
    {
      "source": "/shop",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/orders",
      "destination": "/index.html"
    },
    {
      "source": "/product/:id*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|registerSW\\.js|workbox|manifest|favicon|apple-touch|pwa-|\\.well-known).*)",
      "destination": "/index.html"
    }
  ]
}
